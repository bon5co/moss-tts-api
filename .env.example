# Bearer token clients must send as `Authorization: Bearer <key>`.
# Leave empty to disable auth (local-only use).
API_KEY=

MODEL_ID=OpenMOSS-Team/MOSS-TTS-v1.5
# auto picks cuda > mps > cpu
DEVICE=auto
# auto = bfloat16 on gpu, float32 on cpu
DTYPE=auto
MAX_NEW_TOKENS=2048

# Reference clips for voice cloning: voices/<name>.wav → request voice=<name>
VOICES_DIR=voices

HOST=0.0.0.0
PORT=8766
