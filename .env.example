# Bearer token clients must send as `Authorization: Bearer <key>`.
# Leave empty to disable auth (local-only use).
API_KEY=

MODEL_ID=OpenMOSS-Team/MOSS-TTS-v1.5
# auto picks cuda > mps > cpu
DEVICE=auto
# auto = bfloat16 on gpu, float32 on cpu
DTYPE=auto
MAX_NEW_TOKENS=2048

# Reference clips for voice cloning: voices/<name>.wav → request voice=<name>
VOICES_DIR=voices

# Generation language applied when a request omits `language` on
# /v1/audio/speech and /v1/audio/clone. Plain language names, e.g.
# Japanese, French, Thai (MOSS-TTS-v1.5 supports 31). Leave unset to let
# the model infer the language from the text. Not used by voice-design.
# DEFAULT_LANGUAGE=

HOST=0.0.0.0
PORT=8766

# =========================================================================
# Temporal worker mode (`make worker`). Same file as the server on purpose:
# one repo, one .env, so the object-storage secret is written once. The worker
# does not need any of the server's settings -- it reaches it over HTTP -- but
# a single machine often runs both.
# =========================================================================
# is the default, so an empty file works on the LAN; only the secret key must
# be set.

# --- Temporal (the cluster OpenTanuki runs on the raphael host) ---
MOSS_TEMPORAL_ADDRESS=raphael.local:7233
MOSS_TEMPORAL_NAMESPACE=moss
MOSS_TASK_QUEUE=moss-tts

# --- the MOSS-TTS server (moss-tts-api, running on a Mac) ---
MOSS_TTS_URL=http://calicoagent.tail200737.ts.net:8766
# Only if the server was started with API_KEY set.
MOSS_TTS_API_KEY=
# Refuse to start the worker when the TTS server does not answer /health.
MOSS_TTS_STARTUP_CHECK=1

# --- object storage (the same MinIO that serves zimage, different bucket) ---
# MOSS_S3_* wins; ZIMAGE_S3_* is accepted as a fallback because ~/.env already
# exports those and it is literally the same MinIO.
MOSS_S3_ENDPOINT=http://raphael.local:9100
# Only set when readers reach MinIO by a different name than the worker does.
MOSS_S3_PUBLIC_ENDPOINT=
MOSS_S3_BUCKET=moss
MOSS_S3_ACCESS_KEY=minio
MOSS_S3_SECRET_KEY=            # see ~/KEYS.toml, [zimage_minio]
# The bucket is anonymous-read, so URLs are plain and never expire. Set to 1
# only if you make the bucket private.
MOSS_S3_PRESIGN=0

# --- timeouts (see README: measured spread is 5x on identical input) ---
MOSS_CLIP_TIMEOUT_SECONDS=1200
MOSS_HEARTBEAT_SECONDS=5

# --- limits (rejected as non-retryable errors, not clamped silently) ---
MOSS_MAX_CHARS=4096
MOSS_MAX_LINES=200
